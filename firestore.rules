rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - email: string (required)
    //   - role: string (required) - 'admin'
    //
    // Collection: projects
    // Fields: title, type, image_url, link, created_at
    //
    // Collection: testimonials
    // Fields: name, role, text, image_url, created_at
    //
    // Collection: gallery
    // Fields: image_url, group_id, created_at
    // ===============================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "oxerfy@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }
    
    function isValidString(val, maxLength) {
      return val is string && val.size() > 0 && val.size() <= maxLength;
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 1000 && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /projects/{document} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidString(request.resource.data.title, 200) &&
        isValidString(request.resource.data.type, 100) &&
        isValidUrl(request.resource.data.image_url) &&
        (!("description" in request.resource.data) || isValidString(request.resource.data.description, 2000));
      allow delete: if isAdmin();
    }

    match /testimonials/{document} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidString(request.resource.data.name, 100) &&
        isValidString(request.resource.data.role, 100) &&
        isValidString(request.resource.data.text, 2000) &&
        isValidUrl(request.resource.data.image_url);
      allow delete: if isAdmin();
    }

    match /gallery/{document} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidUrl(request.resource.data.image_url);
      allow delete: if isAdmin();
    }

    match /site_assets/{document} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidString(request.resource.data.key, 100) &&
        isValidUrl(request.resource.data.image_url);
      allow delete: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
